{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hfa-naturalistic-axis-assessment-v2",
  "title": "NaturalisticAxisAssessmentV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score",
    "status"
  ],
  "properties": {
    "score": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "code",
        "unresolved",
        "not_scored"
      ]
    },
    "code": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        null
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejectedAlternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "code"
          }
        }
      },
      "then": {
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "unresolved",
              "not_scored"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "score": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "not_scored"
          }
        }
      }
    }
  ]
}
