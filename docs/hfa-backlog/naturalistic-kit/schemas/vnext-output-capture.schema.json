{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hfa-naturalistic-vnext-output-capture",
  "title": "NaturalisticVNextOutputCapture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "engineVersion", "taxonomyVersion", "capturedAt"],
  "properties": {
    "schemaVersion": { "const": "NATURALISTIC_VNEXT_OUTPUT_V1" },
    "caseId": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string", "minLength": 1 },
    "taxonomyVersion": { "type": "string", "minLength": 1 },
    "methodologyVersion": { "type": "string" },
    "capturedAt": { "type": "string", "minLength": 1 },
    "perceptionCode": { "type": ["string", "null"] },
    "objectiveCode": { "type": ["string", "null"] },
    "actionCode": { "type": ["string", "null"] },
    "perceptionStatus": { "type": ["string", "null"] },
    "objectiveStatus": { "type": ["string", "null"] },
    "actionStatus": { "type": ["string", "null"] },
    "rawOutputRef": {
      "type": ["string", "null"],
      "description": "Pointer only; do not embed full narrative unless authorized"
    }
  }
}
